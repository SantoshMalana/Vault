# Local dashboard talks to the separately running gateway.
VAULT_GATEWAY_URL=http://127.0.0.1:7400
# Set true behind an HTTPS ingress; false is for localhost HTTP only.
VAULT_COOKIE_SECURE=false
# Set the exact public origin behind a reverse proxy (no trailing slash).
# VAULT_PUBLIC_ORIGIN=https://vault.example.com
# Optional: name a client-IP header ONLY if your ingress overwrites it and
# blocks direct access to the dashboard. Otherwise login throttling is shared.
# VAULT_CLIENT_IP_HEADER=x-real-ip
# The original simulator is opt-in. The default is the durable application.
VAULT_MODE=durable
