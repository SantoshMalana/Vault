{
  "name": "vault-distributed-storage",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-dashboard.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint services scripts test app/api/session app/api/v1 components/vault/durable-dashboard.tsx",
    "format:check": "prettier --check services scripts test app/api/session app/api/v1 components/vault/durable-dashboard.tsx app/vault.css",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "vault:dev": "node scripts/dev-cluster.mjs",
    "vault:token": "node scripts/dev-cluster.mjs --token",
    "vault:gateway": "node services/gateway.mjs",
    "vault:node": "node services/storage.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
